<?xml version="1.0" encoding="UTF-8"?>
<extent-config>
    <extentreports>
        <configuration>
            <!-- Report Name -->
            <reportName>Automation Test Report</reportName>

            <!-- Report Document Title -->
            <documentTitle>ExtentReports - Playwright BBD Test Report</documentTitle>

            <!-- Report Encoding -->
            <encoding>UTF-8</encoding>

            <!-- Report Theme -->
            <theme>dark</theme>

            <!-- Chart Visibility -->
            <chartVisibilityOnOpen>true</chartVisibilityOnOpen>

            <!-- Timeline Test View Configuration -->
            <timelineTestViewEnabled>true</timelineTestViewEnabled>

            <!-- Timezone -->
            <timezone>GMT</timezone>


            <!-- view report without internet -->
            <offlineMode>false</offlineMode>

            <!-- settings to change component location -->
            <testViewChartLocation>top</testViewChartLocation>
            <chartVisibleOnOpen>true</chartVisibleOnOpen>
            <testViewChartLocation>bottom</testViewChartLocation>
            <enableTimeline>true</enableTimeline>

            <!-- settings to enable/disable views -->
            <enableCategoryView>true</enableCategoryView>
            <enableAuthorView>true</enableAuthorView>
            <enableExceptionView>true</enableExceptionView>
            <enableTestRunnerLogsView>true</enableTestRunnerLogsView>
            <!-- System Info -->
            <systemInfo>
                <parameter>
                    <name>Operating System</name>
                    <value>Windows 10</value>
                </parameter>
                <parameter>
                    <name>Java Version</name>
                    <value>20</value>
                </parameter>
            </systemInfo>
        </configuration>
    </extentreports>
</extent-config>
